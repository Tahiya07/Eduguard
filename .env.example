# Final deployed Bloom classifier: FedProx IID r20 best (Qwen2.5-0.5B)
BLOOM_MODEL_SIZE=0.5b
BLOOM_MODEL_DIR=models/qwen_bloom_merged0.5B
BLOOM_USE_QUANTIZED=false
# Shared student/teacher generator: save the selected multitask Qwen2.5-1.5B GGUF here.
# Replace this file when a better checkpoint is selected, then restart the backend.
GENERATOR_MODEL_PATH=models/qwen.gguf
RETRIEVAL_ENCODER=bge-small
OFFLINE_MODE=true
MAX_UPLOAD_MB=20
BLOOM_GATE_THRESHOLD=0.40
GENERATOR_THREADS=8
GENERATOR_CONTEXT_TOKENS=512
GENERATOR_ANSWER_TOKENS=64
GENERATOR_SUMMARY_TOKENS=80
GENERATOR_MODERATION_TOKENS=64
GENERATOR_REWRITE_TOKENS=64
# Replace all three before a shared deployment.
SESSION_SECRET=replace-with-a-long-random-secret
STUDENT_ACCESS_CODE=student-local
TEACHER_ACCESS_CODE=teacher-local
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Railway production example (set in Railway Variables, not in a committed .env):
# DATA_DIR=/data/web_sessions
# GENERATOR_MODEL_PATH=/data/models/qwen.gguf
# BLOOM_MODEL_DIR=/data/models/qwen_bloom_merged0.5B

